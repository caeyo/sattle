fn main() -> i32 {
    if true && false {
        print(1);
    } else {
        print(0);
    }
    if false || true {
        print(1);
    } else {
        print(0);
    }
    if !false {
        print(1);
    } else {
        print(0);
    }
    if true || false && false {
        print(1);
    } else {
        print(0);
    }
    if 1 < 2 && 3 < 4 {
        print(1);
    } else {
        print(0);
    }
    if !true || false {
        print(1);
    } else {
        print(0);
    }
    return 0;
}
