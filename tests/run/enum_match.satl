enum Color {
    Red,
    Green,
    Blue
}

struct Cell {
    c: Color
}

fn code(c: Color) -> i32 {
    match c {
        Color::Red => { return 1; }
        Color::Green => { return 2; }
        Color::Blue => { return 3; }
    }
}

fn from_ptr(c: *Color) -> i32 {
    match c {
        Color::Red => { return 10; }
        Color::Green => { return 20; }
        Color::Blue => { return 30; }
    }
}

fn main() -> i32 {
    print(code(Color::Red));
    print(code(Color::Green));
    print(code(Color::Blue));
    if Color::Red == Color::Red {
        print(1);
    }
    if Color::Red != Color::Green {
        print(1);
    }
    let c = Color::Green;
    print(from_ptr(&c));
    let cell = Cell { c: Color::Blue };
    print(code(cell.c));
    return 0;
}
