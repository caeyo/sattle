struct Point {
    x: i32,
    y: i32
}

fn bump(p: *Point, n: i32) -> i32 {
    p.x = p.x + n;
    return p.x;
}

fn main() -> i32 {
    let p = Point { x: 1, y: 2 };
    print(p.x);
    print(p.y);
    p.y = 4;
    print(p.y);
    print(bump(&p, 10));
    print(p.x);
    let q: *i32 = &p.y;
    *q = 7;
    print(p.y);
    return 0;
}
